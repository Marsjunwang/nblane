# nblane · LLM configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit API keys.

# # --- Required for AI features ---
# LLM_API_KEY=sk

# --- Optional: language settings ---
# UI_LANG=zh
# LLM_REPLY_LANG=en

# --- Optional: change to use a different model or provider ---

# # OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-nano

# Anthropic (via openai-compatible proxy)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-5-sonnet-20241022

# Alibaba DashScope / 阿里云百炼
# 阿里云百炼 API Key (DASHSCOPE_API_KEY)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型列表: https://help.aliyun.com/model-studio/getting-started/models
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# Optional visual generation overrides.
# DashScope / Qwen visual generation reuses LLM_API_KEY by default.
# Set VISUAL_API_KEY only when image/video credentials are different.
VISUAL_PROVIDER=dashscope_wan
VISUAL_IMAGE_MODEL=wan2.7-image-pro
VISUAL_IMAGE_FAST_MODEL=wan2.7-image
VISUAL_VIDEO_MODEL=wan2.7-videoedit
VISUAL_API_KEY=

# Optional Codex CLI / Codex Cloud integration.
# Codex auth is managed by `codex login`; do not put Codex tokens here.
# Kanban can use local Codex as a read-only AI backend.
# Install/upgrade helper:
#   nblane codex install --print-command
#   nblane codex install
# Explicit CLI patch runner:
#   nblane codex local run <agent_task_id> --profile <name>
# Per-profile overrides can also live in profiles/<name>/codex.yaml.
NBLANE_CODEX_BIN=codex
NBLANE_CODEX_CLOUD_ENV_ID=
NBLANE_CODEX_MODEL=
NBLANE_CODEX_ATTEMPTS=1
NBLANE_CODEX_BRANCH=
NBLANE_CODEX_TIMEOUT_SECONDS=180

# Paper Reading structured extraction.
# Optional self-hosted GROBID REST service. When unset, Paper Reading falls back to PyMuPDF/page-text extraction.
NBLANE_GROBID_URL=http://127.0.0.1:8070
NBLANE_RESEARCH_STRUCTURE_BACKEND=grobid

# Local Ollama (no key needed, use any string)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
