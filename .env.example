# nblane · LLM configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit API keys.
#
# The LLM connection (base URL/key/model) is deployment-wide and can be
# edited permanently from the Settings page in the UI, which writes back to
# this file. Dev-only: when running `scripts/dev-web.sh --isolated`,
# NBLANE_ENV_FILE overrides which .env the app reads/writes, since NBLANE_ROOT
# points at an isolated .dev-data dir in that mode. Leave unset otherwise.
# NBLANE_ENV_FILE=/path/to/.env

# # --- Required for AI features ---
# LLM_API_KEY=sk

# --- Optional: language settings ---
# UI_LANG=zh
# LLM_REPLY_LANG=en

# --- Optional: change to use a different model or provider ---

# # OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-nano

# Anthropic (via openai-compatible proxy)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-5-sonnet-20241022

# Alibaba DashScope / 阿里云百炼
# 阿里云百炼 API Key (DASHSCOPE_API_KEY)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型列表: https://help.aliyun.com/model-studio/getting-started/models
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# Optional: embedding model for skill-link suggestions (evidence -> skills).
# Any OpenAI-compatible /embeddings model reusing LLM_BASE_URL/LLM_API_KEY.
# Skill label/category embeddings are cached under profiles/<name>/.cache/.
# Unset (default): suggestions fall back to one LLM ranking call, then to
# the deterministic rule matcher.
# LLM_EMBEDDING_MODEL=text-embedding-v4

# Optional visual generation overrides.
# DashScope / Qwen visual generation reuses LLM_API_KEY by default.
# Set VISUAL_API_KEY only when image/video credentials are different.
VISUAL_PROVIDER=dashscope_wan
VISUAL_IMAGE_MODEL=wan2.7-image-pro
VISUAL_IMAGE_FAST_MODEL=wan2.7-image
VISUAL_VIDEO_MODEL=wan2.7-videoedit
VISUAL_API_KEY=

# Optional Codex CLI / Codex Cloud integration.
# Codex auth is managed by `codex login`; do not put Codex tokens here.
# Kanban can use local Codex as a read-only AI backend.
# Install/upgrade helper:
#   nblane codex install --print-command
#   nblane codex install
# Explicit CLI patch runner:
#   nblane codex local run <agent_task_id> --profile <name>
# Per-profile overrides can also live in profiles/<name>/codex.yaml.
NBLANE_CODEX_BIN=codex
NBLANE_CODEX_CLOUD_ENV_ID=
NBLANE_CODEX_MODEL=
NBLANE_CODEX_ATTEMPTS=1
NBLANE_CODEX_BRANCH=
NBLANE_CODEX_TIMEOUT_SECONDS=180

# Paper Reading structured extraction.
# NBLANE_RESEARCH_PDF_BACKEND selects the PDF backend: pymupdf | grobid | auto
# (default: auto). "auto" probes NBLANE_GROBID_URL and uses GROBID when it is
# reachable, otherwise falls back to PyMuPDF / page-text extraction.
# Set NBLANE_RESEARCH_PDF_BACKEND=pymupdf to force-disable GROBID probing, e.g.
# to keep a dev instance on the same host from talking to a production GROBID.
# NBLANE_GROBID_URL points at an optional self-hosted GROBID REST service.
# Setting it to "off"/"none" also disables GROBID; an empty value does NOT
# disable it (empty falls back to the default http://127.0.0.1:8070).
NBLANE_GROBID_URL=http://127.0.0.1:8070
NBLANE_RESEARCH_PDF_BACKEND=auto

# Local Ollama (no key needed, use any string)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# --- Production security (HTTPS deployments) ---
# Login cookie Secure flag. Set to 1 in HTTPS production so the session cookie
# is only sent over TLS. Leave unset (default 0) for local HTTP development.
# NBLANE_AUTH_COOKIE_SECURE=1
# Trust X-Forwarded-For for login rate limiting (SPA backend, nblane.web_api).
# Set to 1 ONLY when the app sits behind a reverse proxy (e.g. Caddy) that
# overwrites X-Forwarded-For and the app port is not directly reachable;
# without it, all proxy clients share one 127.0.0.1 rate-limit bucket, but
# enabling it on a directly reachable app lets clients spoof their bucket.
# NBLANE_TRUST_PROXY_HEADERS=1

# --- Workshop 车间（远程网页终端，SPA「车间」页 iframe 嵌入 ttyd）---
# NBLANE_WORKSHOP_URL：浏览器侧 iframe 地址。默认 /terminal/（同源相对路径，
# 生产由 Caddy 反代 127.0.0.1:7668 并挂 basic_auth）。本地 dev 无此反代，
# 直连设为 http://127.0.0.1:7668/ 。
# NBLANE_WORKSHOP_URL=http://127.0.0.1:7668/
# NBLANE_WORKSHOP_PROBE_URL：后端探活 ttyd 的地址（ttyd 只绑 loopback，
# 服务端探测不受 Caddy 影响）。默认 http://127.0.0.1:7668 。
# NBLANE_WORKSHOP_PROBE_URL=http://127.0.0.1:7668

# --- OpenClaw 反向推送（nblane → 微信，webhook MVP，`nblane notify`）---
# NBLANE_OPENCLAW_HOOK_URL：OpenClaw Gateway 入站钩子地址；openclaw.json 里的
# `webhooks` 映射把 /hooks/<name> 路由到某个自动化。默认 http://127.0.0.1:18789/hooks/agent
# NBLANE_OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/agent
# NBLANE_OPENCLAW_HOOK_TOKEN：必填，取值与 openclaw.json 的 cron.webhookToken
# 一致；只从本文件/环境读取，永不入库、永不打印明文。
# NBLANE_OPENCLAW_HOOK_TOKEN=

# --- OpenClaw → nblane HTTP API 客户端（scripts/openclaw/skills/bin/nblane_api.py）---
# NBLANE_OPENCLAW_API_PASSWORD：openclaw 服务账号（member，仅王军 profile）登录
# /api/v1/auth/login 的密码；客户端只从环境读取，绝不硬编码、绝不打印。
# NBLANE_OPENCLAW_API_PASSWORD=
# NBLANE_API_BASE：API base URL 覆盖，默认 http://127.0.0.1:8504 。
# NBLANE_API_BASE=http://127.0.0.1:8504
